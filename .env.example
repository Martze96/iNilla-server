# Copy to .env and fill in. This is the only file that differs between machines.
#
#   cp .env.example .env
#   docker compose up -d
#
# Values are unquoted; spaces are fine.

# ---- required ---------------------------------------------------------------------------------
# Your World of Warcraft 1.12.1 (build 5875, enUS) client's Data folder — the one holding dbc.MPQ,
# patch.MPQ, terrain.MPQ and the rest. Mounted read-only: the server's map data is extracted from
# it once, and the data host serves it to the app. Absolute path; on Windows use forward slashes.
WOW_DATA_DIR=C:/Games/World of Warcraft 1.12.1/Data

# This machine's address on your LAN, as the phone reaches it. realmd hands it to the app as the
# world server's address, so `localhost` or a container name will not do. An IPv4 address (give
# the machine a fixed DHCP lease in your router) or a hostname every device resolves, 32 chars max.
REALM_ADDRESS=192.168.1.20

# Secrets. Letters, digits, '.', '_' and '-' only. Generate some with:
#   openssl rand -hex 16
DB_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-mangos

# ---- the data host (game data and addons for the app) -------------------------------------------
# Empty: anyone on your network can download the game data, and the app needs no token (the easy
# way at home). Set one before the host is reachable from the internet; the app then asks for it.
INILLA_DATA_TOKEN=
# Optional: a German 1.12.1 client's Data folder. The app then offers German at setup: the game
# in German, quests and NPCs included, with pfQuest in German. See docs/OPERATIONS.md, "German".
#WOW_DATA_DIR_DEDE=C:/Games/WoW 1.12.1 deDE/Data

# ---- the realm --------------------------------------------------------------------------------
REALM_NAME=iNilla
# pve, pvp, rp or rppvp
REALM_TYPE=pve
# The server's clock (day/night, resets). Any tz database name, e.g. Europe/Berlin.
TZ=UTC

# ---- server map data (extracted from WOW_DATA_DIR on the first `up`) -------------------------------
# vmaps: line of sight, indoor checks, heights (a few minutes). Strongly recommended.
EXTRACT_VMAPS=1
# mmaps: creature pathfinding around obstacles (hours on the first run). Without them mobs chase
# in straight lines. To build them while the realm keeps running, see docs/OPERATIONS.md.
EXTRACT_MMAPS=0

# ---- ports ------------------------------------------------------------------------------------
# 0.0.0.0 = reachable from the LAN (the point). 127.0.0.1 = this machine only.
BIND_ADDR=0.0.0.0
REALMD_PORT=3724
MANGOSD_PORT=8085
DATAHOST_PORT=8099

# ---- versions ---------------------------------------------------------------------------------
# The vmangos commit to build (github.com/vmangos/core, branch development). Changing it rebuilds
# the image on the next `up`, and db-init applies the new migrations. Pair it with a database
# snapshot no newer than the core (db-init warns when it is newer).
#VMANGOS_COMMIT=53d24d5c748bef5e0cde7b1155bcb3d979af614c
# Empty = the current db_latest release of vmangos/core.
#VMANGOS_DB_URL=

# The language of WOW_DATA_DIR's client, as the data host advertises it.
#WOW_LOCALE=enUS
